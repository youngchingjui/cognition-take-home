# Devin API credentials
DEVIN_API_KEY=cog_your_key_here
DEVIN_ORG_ID=your_org_id_here

# GitHub credentials
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Smee.io webhook proxy URL (only needed for local development with Docker Compose)
# Create a channel at https://smee.io/new and paste the URL here
# SMEE_URL=https://smee.io/your-channel-id

# Database (set automatically by Docker Compose; only needed for standalone use)
# DATABASE_URL=postgresql://devin:devin@localhost:5432/devin_webhook
